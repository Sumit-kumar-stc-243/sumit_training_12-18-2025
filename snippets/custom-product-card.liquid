<div class="product-card">
  <a href="{{ product.url }}">
    <img
      src="{{ product.featured_image | image_url: width: 300 }}"
      alt="{{ product.title }}"
      loading="lazy"
      height="290px"
      width="271px"
      class="product-image"
    >
    <h4>{{ product.title }}</h4>
    <h5>{{ product.type }}</h5>
  </a>

  <button
    class="add-to-cart"
    type="button"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  >
    ADD TO BAG - {{ product.price | money }}
  </button>
</div>
