<script src="{{ 'cart-update.js' | asset_url }}" defer></script>

<style>
  #recently-viewed-section{
    padding: 10px 25px;
  }
  .shop_btn{
    background-color: {{ section.settings.button_color }};
    border:none;
    color:white;
    border-radius:90px;
    padding:5px 66px;
    cursor:pointer;
    font-size: 16px;
  }
  .swiper-slide{
    background:none;
  }
  .product-image{
    border-radius:20px;
    height: 170px !important;
    width: 197px !important;
    object-fit: contain !important;
  }
  .product-card{
    text-align:left;
  }
  .product-card h4{
    font-size: 15px;
    font-weight: 400;
    color: #3F434C;
    margin: 0px;
  }
  .product-card h5{
    font-size: 20px;
    font-weight: 400;
    color: #000000;
    margin: 0px;
  }
  .product-card button{
    outline:none;
    border:1px solid #DB763F ;
    border-radius:20px;
    padding:9px 28px;
    background:none;
    cursor:pointer;
    margin-top:10px;
  }
  .bestSellerProducts {
    padding-bottom: 30px;
  }
  .bestSellerProducts .swiper-scrollbar {
    height: 4px;
    background: #e5e5e5;
    position:static;
  }

  .bestSellerProducts .swiper-scrollbar-drag {
    background:rgb(0, 0, 0);
    border-radius: 10px;
  }
  .swiper-slide a{
    text-decoration:none;
  }
  .btn-next , .btn-prev{
    color: black;
    border-radius: 50%;
    border: 1px solid rgba(86, 86, 86, 0.3);
    width: 26px;
    height: 26px;
    padding: 4px;
    position: relative;
    bottom: -6px;
  }
  .swiper-buttons{
    display: flex;
    gap: 10px;
    flex-direction: row-reverse;
    width: 10%;
  }
  .draggleBar{
    display: flex;
    align-items: center;
    gap: 5%;
    margin-top: 10px;
  }

  @media (max-width:449px){
    .best-seller-container{
      display:block;
    }
  }
</style>
<div id="recently-viewed-section"></div>

<script>
  function renderProducts(products) {
    const section = document.getElementById('recently-viewed-section');
    if (!section || !products.length) return;

    section.innerHTML = '';

    const heading = document.createElement('h2');
    heading.textContent = '{{ section.settings.heading | escape }}';

    const swiper = document.createElement('div');
    swiper.className = 'swiper recently-viewed-swiper';

    swiper.innerHTML = `
            <div class="swiper-wrapper">
              ${products
                .map(
                  (product) => `
                    <div class="swiper-slide">
                      <div class="product-card">
                        <a href="/products/${product.handle}">
                          <img
                            src="${product.featuredImage?.url || ''}"
                            alt="${product.title}"
                            loading="lazy"
                            class="product-image"
                          >
                          <h4>${product.title}</h4>
                        </a>
      
                        <button
                          class="add-to-cart"
                          type="button"
                          data-product-id="${product.id}"
                        >
                          ADD TO BAG
                        </button>
                      </div>
                    </div>
                  `
                )
                .join('')}
            </div>
          `;

    section.appendChild(heading);
    section.appendChild(swiper);

    initRecentlyViewedSwiper();
  }

  function initRecentlyViewedSwiper() {
    new Swiper('.recently-viewed-swiper', {
      slidesPerView: 4,
      spaceBetween: 20,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        0: {
          slidesPerView: 1.2,
        },
        640: {
          slidesPerView: 2.2,
        },
        1024: {
          slidesPerView: 4,
        },
      },
    });
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const productIds = JSON.parse(localStorage.getItem('productIds')) || [];
    if (!productIds.length) return;

    try {
      const query = `
          query getProducts($ids: [ID!]!) {
            nodes(ids: $ids) {
              ... on Product {
                id
                title
                handle
                featuredImage {
                  url
                }
                priceRange {
                  minVariantPrice {
                    amount
                    currencyCode
                  }
                }
              }
            }
          }
        `;

      const response = await fetch('/api/2024-01/graphql.json', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': 'b3bb29e8d8c21c4bdfef660da16877fd',
        },
        body: JSON.stringify({
          query,
          variables: { ids: productIds.map((id) => `gid://shopify/Product/${id}`) },
        }),
      });

      const { data, errors } = await response.json();
      const products = (data.nodes || []).filter(Boolean);
      renderProducts(products);
    } catch (error) {
      console.error('Fetch error:', error);
    }
  });
</script>

{% schema %}
{
  "name": "recently-viewed-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Add Heading",
      "default": "Recently Viewed Products"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Text Alignment",
      "default": "left"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 60,
      "step": 2,
      "default": 16,
      "label": "Font size"
    },
    {
      "type": "range",
      "id": "font-weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 600,
      "label": "font weight"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Recently Viewed Products"
    }
  ]
}
{% endschema %}
