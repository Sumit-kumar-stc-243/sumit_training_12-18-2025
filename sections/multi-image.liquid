{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<slideshow-component
  class="multi-image-slideshow"
  aria-roledescription="carousel"
  role="region"
>
  <div class="multi-image-slideshow__wrapper slider-buttons">
    {%- if section.settings.show_buttons -%}
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="Previous slide"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    {%- endif -%}

    <div
      id="Slider-{{ section.id }}"
      class="multi-image-slideshow__slider slider slider--everywhere"
      aria-live="polite"
      aria-atomic="true"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div
            class="slideshow__slide slider__slide"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1500 }}"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- elsif section.settings.image != blank -%}
        <div class="slideshow__slide slider__slide">
          <img
            src="{{ section.settings.image | image_url: width: 1500 }}"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_buttons -%}
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="Next slide"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    {%- endif -%}
  </div>
</slideshow-component>

{% schema %}
{
  "name": "Multi Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show navigation buttons",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ]
}
{% endschema %}