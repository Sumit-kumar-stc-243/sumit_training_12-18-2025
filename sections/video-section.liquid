<style>
  .video-section-container {
    background-color:#FFF9F6;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding: 10px 25px;
    gap: 10px;
  }
  .video-wrapper {
    width: 100%;
    position:relative;
  }
  .video-wrapper video {
    width: 100%;
    height:  {{ section.settings.video_height }}px;
  }
  .video-info p {
    margin: 0px;
    font-size: 18px;
  }
  .video-info button{
    background-color:#DB763F;
    border-radius:99px;
    color:#FFFFFF;
    border:none;
    box-shadow: 0px 2px 4px 0px #00000040;
    padding:10px 40px;
    cursor:pointer;
  }
  .block-slides{
    height:190px;
    width:100% !important; /* let Swiper control width */
    background-color:#FFFFFF;
    border-radius:10px;
  }

  .swiper-slide{
    flex-shrink: 0;
  }
  .block-card > img{
    width:40px;
    height:40px;
  }
  .block-card{
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .block-card > h3{
    margin: 4px;
   }
  .block-card > p {
    font-size:14px;
  }
  .block-swiper {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin-top:10px;
  }
  .custom-wrapper{
    gap:10px;
  }

  #customSwiper {
    width: 100%;
    height: 190px;
    overflow: hidden; /* 🔥 removes extra space */
  }
   .button-swipper{
    width:30px;
    height:30px;
    border-radius:50%;
    border:1px solid black;
    padding:5px;
    color: black;
   }
   .play-btn {
    position: absolute;
    top: 33%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    z-index: 2;
    cursor: pointer;
    border: none;
    border-radius: 50%;
    height: 50px;
    width: 50px;
    background-color:black;
    color:white;
  }
</style>

<div class="video-section-container">
  {% if section.settings.video != blank %}
    <div class="video-wrapper">
      {{
        section.settings.video
        | video_tag: poster: section.settings.poster, controls: false, autoplay: false, loop: true, muted: false
      }}
      <button class="play-btn">Play</button>
    </div>
  {% endif %}

  <div class="video-info">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.para }}</p>
    <button>{{ section.settings.btn_text }}</button>

    {% if section.blocks.size > 0 %}
      <div class="swiper mySwiper block-swiper" id="customSwiper">
        <div class="swiper-wrapper custom-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide block-slides">
              <div class="block-card">
                {% if block.settings.icon != blank %}
                  <img src="{{ block.settings.icon | image_url }}" alt="" height="" width="">
                {% endif %}
                <h3>{{ block.settings.heading_slide }}</h3>
                <p>{{ block.settings.para_slide }}</p>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Navigation -->
        <div class="swiper-button-next button-swipper">&nbsp;</div>
        <div class="swiper-button-prev button-swipper">&nbsp;</div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('#customSwiper', {
      slidesPerView: 3,
      spaceBetween: 0,
      autoplay: false,
      watchOverflow: true,

      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>

{% schema %}
{
  "name": "Video-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Thumbnail"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Add Video"
    },
    {
      "type": "range",
      "id": "video_height",
      "label": "Video Height",
      "min": 100,
      "max": 1000,
      "step": 10,
      "default": 500
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Add Heading"
    },
    {
      "type": "richtext",
      "id": "para",
      "label": "Enter Paragraph"
    },
    {
      "type": "text",
      "id": "btn_text",
      "default": "Read More",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Url"
    }
  ],
  "blocks": [
    {
      "type": "Slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "slide_icon"
        },
        {
          "type": "text",
          "id": "heading_slide",
          "label": "Add Heading"
        },
        {
          "type": "text",
          "id": "para_slide",
          "label": "Add Para"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Section"
    }
  ]
}
{% endschema %}
