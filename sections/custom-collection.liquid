<style>
  .custom-collection-sections {
    padding: 40px 0;
  }

  .custom-collection-sections .heading {
    margin-bottom: 24px;
    text-align: {{ section.settings.heading_alignment }};
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 600;
  }

  .custom-collection-sections .collection-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }

  .custom-collection-sections .collection-item {
    text-align: left;
  }

  .custom-collection-sections .collection-item-image {
    width: 100%;
    overflow: hidden;
  }

  .custom-collection-sections .collection-item-image--square {
    aspect-ratio: 1 / 1;
  }

  .custom-collection-sections .collection-item-image--landscape {
    aspect-ratio: 4 / 3;
  }

  .custom-collection-sections .collection-item-image--portrait {
    aspect-ratio: 3 / 4;
  }

  .custom-collection-sections .collection-item-image--auto img {
    height: auto;
  }

  .custom-collection-sections .collection-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-collection-sections .collection-item-title {
    margin-top: 12px;
    font-weight: 500;
  }

  .custom-collection-sections .collection-item-image img:first-child {
    border-radius: 60px 0px 0px 0px;
  }

  .custom-collection-sections .collection-item-subtitle {
    margin-top: 4px;
  }
</style>

<div class="custom-collection-sectionss">
  <div class="heading">
    {{ section.settings.heading }}
  </div>
  <div class="collection-container">
    {%- for block in section.blocks -%}
      <div
        class="collection-item"
        style="text-align: {{ block.settings.card_text_alignment | default: section.settings.card_text_alignment }};"
      >
        <div class="collection-item-image collection-item-image--{{ block.settings.image_aspect_ratio | default: section.settings.image_aspect_ratio }}">
          {% if block.settings.collection != blank and block.settings.collection.url != blank %}
            <a href="{{ block.settings.collection.url }}">
              <img
                src="{{ block.settings.image | image_url: width: section.settings.image_max_width }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
                width="{{ section.settings.image_max_width }}"
                height="{{ section.settings.image_max_width | divided_by: block.settings.image.aspect_ratio | round }}"
                style="border-radius: {{ block.settings.image_border_radius | default: section.settings.image_border_radius }};"
              >
            </a>
          {% else %}
            <img
              src="{{ block.settings.image | image_url: width: section.settings.image_max_width }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.image_max_width }}"
              height="{{ section.settings.image_max_width | divided_by: block.settings.image.aspect_ratio | round }}"
              style="border-radius: {{ block.settings.image_border_radius | default: section.settings.image_border_radius }};"
            >
          {% endif %}
          
        </div>
        {%- if block.settings.title != blank -%}
          <div
            class="collection-item-title"
            style="
              color: {{ block.settings.item_title_color | default: section.settings.item_title_color }};
              font-size: {{ block.settings.item_title_font_size | default: section.settings.item_title_font_size }}px;
            "
          >
            {{ block.settings.title }}
          </div>
        {%- endif -%}
        {%- if block.settings.subtitle != blank -%}
          <div
            class="collection-item-subtitle"
            style="
              color: {{ block.settings.item_subtitle_color | default: section.settings.item_subtitle_color }};
              font-size: {{ block.settings.item_subtitle_font_size | default: section.settings.item_subtitle_font_size }}px;
            "
          >
            {{ block.settings.subtitle }}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom collection section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom collection heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image shape",
      "default": "square",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Rectangle landscape (4:3)" },
        { "value": "portrait", "label": "Rectangle portrait (3:4)" }
      ]
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width (px)",
      "min": 100,
      "max": 800,
      "step": 10,
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "custom_collection",
      "name": "Custom collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Add Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item name / title",
          "default": "Custom collection title"
        },
        {
          "type": "select",
          "id": "card_text_alignment",
          "label": "Card text alignment",
          "default": "center",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / description"
        },
        {
          "type": "select",
          "id": "image_aspect_ratio",
          "label": "Image shape",
          "default": "square",
          "options": [
            { "value": "auto", "label": "Auto" },
            { "value": "square", "label": "Square (1:1)" },
            { "value": "landscape", "label": "Rectangle landscape (4:3)" },
            { "value": "portrait", "label": "Rectangle portrait (3:4)" }
          ]
        },
        {
          "type": "text",
          "id": "image_border_radius",
          "label": "Image border radius (CSS value, e.g. '60px 0 0 0')",
          "default": "12px"
        },
        {
          "type": "color",
          "id": "item_title_color",
          "label": "Item title color",
          "default": "#111111"
        },
        {
          "type": "range",
          "id": "item_title_font_size",
          "label": "Item title font size",
          "min": 12,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "color",
          "id": "item_subtitle_color",
          "label": "Item subtitle color",
          "default": "#555555"
        },
        {
          "type": "range",
          "id": "item_subtitle_font_size",
          "label": "Item subtitle font size",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 14
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom collection",
      "blocks": [{ "type": "custom_collection" }]
    }
  ]
}
{% endschema %}
