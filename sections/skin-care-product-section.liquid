<style>
    .skin-care-product-section{
        position:relative;
    }
    .skin-care-background-image{

    }
    .background_overlay_color{
        background-color:{{ section.settings.background_overlay_color }};
        position:absolute;
        opacity: {{ section.settings.background_overlay_opacity | divided_by: 10.0 }};
        background-color: #000000;
        position: absolute;
        z-index: 1;
        width: 100%;
        height: {% if section.settings.background_overlay_height != blank %}{{ section.settings.background_overlay_height }}{% else %}400{% endif %}px;
        top: 0px;
        display: block !important;
    }
   .skin-care-product-section-heading {
    color: #c2c2c2;
    position: absolute;
    font-weight: 700;
    {% if section.settings.heading_top != blank %}top: {{ section.settings.heading_top }}px;{% endif %}
    {% if section.settings.heading_left != blank %}left: {{ section.settings.heading_left }}px;{% endif %}
    {% if section.settings.heading_bottom != blank %}bottom: {{ section.settings.heading_bottom }}px;{% endif %}
    {% if section.settings.heading_right != blank %}right: {{ section.settings.heading_right }}px;{% endif %}
    color: {{ section.settings.heading_color }};
    opacity: {{ section.settings.heading_opacity | divided_by:10.0 }};
    font-size: {{ section.settings.font_size_heading }}px;
    z-index:2;
  }

  .skin-care-product-section-sub-heading {
    color: #c2c2c2;
    position: absolute;
    font-weight: 700;
    {% if section.settings.sub_heading_top != blank %}top: {{ section.settings.sub_heading_top }}px;{% endif %}
    {% if section.settings.sub_heading_left != blank %}left: {{ section.settings.sub_heading_left }}px;{% endif %}
    {% if section.settings.sub_heading_bottom != blank %}bottom: {{ section.settings.sub_heading_bottom }}px;{% endif %}
    {% if section.settings.sub_heading_right != blank %}right: {{ section.settings.sub_heading_right }}px;{% endif %}
    color: {{ section.settings.sub_heading_color }};
    opacity: {{ section.settings.sub_heading_opacity  | divided_by:10.0  }};
    font-size: {{ section.settings.font_size_sub_heading }}px;
    z-index:2;
  }
  .skin-care-collections{
    position: absolute;
    top: 40px;
    color: white;
    right: 100px;
    background-color: #F7841D;
    border: 1px solid #FFFFFF;
    display: flex;
    padding: 0px 4px;
    gap:2px;
    height: 60px;
    justify-content: space-around;
    align-items: center;
    z-index: 2;
    border-radius:16px;
  }
  .skin-care-category{
    border: none;
    background-color: transparent;
    border-radius: 16px;
    padding: 8px 24px;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.3s ease;
   }
   .skin-care-category.active{
    background-color: white;
    border: 1px solid #FFFFFF;
   }
   .collection-products-wrapper{
    display: none;
   }
   .collection-products-wrapper.active{
    display: block;
   }
   .skin-care-products{
    display:flex;
    gap:10px;
    overflow-x: scroll;
    overflow-y: hidden;
    scrollbar-width: none;      /* Firefox */
    -ms-overflow-style: none;
    width:467px;
    height:100%;
    }
    .skin-care-products::-webkit-scrollbar {
        display: none;              /* Chrome / Safari */
      }
    .product-item{
    background: white;
    color: black;
    border-radius:20px;
    padding:8px;
    }
    .product-item p{
      padding: 0px;
      margin: 0px;
    }
    .product-item a{
        display:flex;
        justify-content:center;
    }
    .skin-care-show-products{
      top:120px !important;
      background-color: transparent !important;
      border:none;
      width: 467px;
      right:5px;
      height: 270px;
    }
    .product-item-image{
        width: 130px;
        border-radius:16px;
        height: 110px;
    }
    .product-title , .product-price{
        margin-top:4px !important;
        font-weight:700;
    }
    .product-type{
        margin-top: -3px;
        line-height: 17px;
    }
    .product-btn{
        border:1px solid #E16A28;
        border-radius:20px;
        background-color:transparent;
        padding:9px 28px;
        cursor:pointer;
    }
</style>

<div class="skin-care-product-section">
  {% if section.settings.background_image != blank %}
    <img
      src="{{ section.settings.background_image | image_url: width: 400 }}"
      alt="{{ product.title }}"
      width="100%"
      height="{% if section.settings.background_overlay_height != blank %}{{ section.settings.background_overlay_height }}{% else %}400{% endif %}px"
      class="skin-care-background-image"
    >
  {% endif %}
  {% if section.settings.background_overlay_color != blank %}
    <div class="background_overlay_color"></div>
  {% endif %}
  {% if section.settings.heading != blank %}
    <div class="skin-care-product-section-heading">{{ section.settings.heading }}</div>
  {% endif %}
  {% if section.settings.sub_heading != blank %}
    <div class="skin-care-product-section-sub-heading">{{ section.settings.sub_heading }}</div>
  {% endif %}

  <div class="skin-care-collections">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      {% if collection %}
        <div class="skin-care-cart-section">
          <button 
            class="skin-care-category {% if forloop.first %}active{% endif %}" 
            data-collection-handle="{{ collection.handle }}"
            data-block-index="{{ forloop.index0 }}"
          >
            {{ block.settings.category_title }}
          </button>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="skin-care-collections skin-care-show-products">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      {% if collection %}
        <div class="collection-products-wrapper {% if forloop.first %}active{% endif %}" data-collection-handle="{{ collection.handle }}">
          <div class="skin-care-products">
            {% assign products_limit = section.settings.products_limit | default: 4 %}
            {% for product in collection.products limit: products_limit %}
              <div class="product-item">
                <a href="{{ product.url }}">
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.title }}"
                    width="200px"
                    height="250px"
                    class="product-item-image"
                  >
                </a>
                <p class="product-title">{{ product.title }}</p>
                <p class="product-type">{{ product.type }}</p>
                <p class="product-price">{{ product.price | money }}</p>
                <form method="post" action="/cart/add">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="product-btn">{{ section.settings.button_label }}</button>
                </form>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const categoryButtons = document.querySelectorAll('.skin-care-category');
      const productWrappers = document.querySelectorAll('.collection-products-wrapper');

      categoryButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          const collectionHandle = this.getAttribute('data-collection-handle');
          
          // Remove active class from all buttons (removes background and border)
          categoryButtons.forEach(function(btn) {
            btn.classList.remove('active');
          });
          
          // Add active class to clicked button (adds background and border)
          this.classList.add('active');
          
          // Hide all product wrappers
          productWrappers.forEach(function(wrapper) {
            wrapper.classList.remove('active');
          });
          
          // Show only the selected collection's products
          const targetWrapper = document.querySelector('.collection-products-wrapper[data-collection-handle="' + collectionHandle + '"]');
          if (targetWrapper) {
            targetWrapper.classList.add('active');
          }
        });
      });
    });
  </script>
</div>

