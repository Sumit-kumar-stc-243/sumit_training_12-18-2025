{% doc %}
  @prompt
    create a carousel to accept multiple images and also we can overlay multiple  text and button we can also custimised size and color , and image of size , and alginment of text and button , carosel button showing or not , timing or many more feature  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.carousel_height }}px;
  }

  .ai-carousel-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}ms ease-in-out;
    pointer-events: none;
  }

  .ai-carousel-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-carousel-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: 40px;
    text-align: {{ block.settings.text_alignment }};
    z-index: 2;
  }

  .ai-carousel-content-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
  }

  .ai-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 700;
  }

  .ai-carousel-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
  }

  .ai-carousel-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
  }

  .ai-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover_color }};
    color: {{ block.settings.button_text_hover_color }};
    border-color: {{ block.settings.button_border_hover_color }};
  }

  {% if block.settings.show_navigation %}
    .ai-carousel-nav-{{ ai_gen_id }} {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      background-color: {{ block.settings.nav_bg_color }};
      color: {{ block.settings.nav_icon_color }};
      border: none;
      width: {{ block.settings.nav_button_size }}px;
      height: {{ block.settings.nav_button_size }}px;
      border-radius: {{ block.settings.nav_border_radius }}px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      opacity: {{ block.settings.nav_opacity | divided_by: 100.0 }};
    }

    .ai-carousel-nav-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.nav_bg_hover_color }};
      color: {{ block.settings.nav_icon_hover_color }};
      opacity: 1;
    }

    .ai-carousel-nav-prev-{{ ai_gen_id }} {
      left: {{ block.settings.nav_position_offset }}px;
    }

    .ai-carousel-nav-next-{{ ai_gen_id }} {
      right: {{ block.settings.nav_position_offset }}px;
    }

    .ai-carousel-nav-{{ ai_gen_id }} svg {
      width: calc({{ block.settings.nav_button_size }}px * 0.5);
      height: calc({{ block.settings.nav_button_size }}px * 0.5);
    }
  {% endif %}

  {% if block.settings.show_dots %}
    .ai-carousel-dots-{{ ai_gen_id }} {
      position: absolute;
      bottom: {{ block.settings.dots_position_bottom }}px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: {{ block.settings.dots_spacing }}px;
      z-index: 3;
    }

    .ai-carousel-dot-{{ ai_gen_id }} {
      width: {{ block.settings.dots_size }}px;
      height: {{ block.settings.dots_size }}px;
      border-radius: 50%;
      background-color: {{ block.settings.dots_color }};
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      opacity: {{ block.settings.dots_opacity | divided_by: 100.0 }};
    }

    .ai-carousel-dot-{{ ai_gen_id }}.active {
      background-color: {{ block.settings.dots_active_color }};
      opacity: 1;
      transform: scale({{ block.settings.dots_active_scale }});
    }

    .ai-carousel-dot-{{ ai_gen_id }}:hover {
      opacity: 1;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-carousel-container-{{ ai_gen_id }} {
      height: {{ block.settings.carousel_height_mobile }}px;
    }

    .ai-carousel-content-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-carousel-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-carousel-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-carousel-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }}
  class="ai-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-carousel-container-{{ ai_gen_id }}">
    <div class="ai-carousel-slides-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_image_key = 'slide_' | append: i | append: '_image'
          assign slide_heading_key = 'slide_' | append: i | append: '_heading'
          assign slide_subheading_key = 'slide_' | append: i | append: '_subheading'
          assign slide_text_key = 'slide_' | append: i | append: '_text'
          assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
          assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign slide_image = block.settings[slide_image_key]
          assign slide_heading = block.settings[slide_heading_key]
          assign slide_subheading = block.settings[slide_subheading_key]
          assign slide_text = block.settings[slide_text_key]
          assign slide_button_text = block.settings[slide_button_text_key]
          assign slide_button_link = block.settings[slide_button_link_key]
        %}

        {% if slide_enabled %}
          <div class="ai-carousel-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
            <div class="ai-carousel-image-wrapper-{{ ai_gen_id }}">
              {% if slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 2000 }}"
                  alt="{{ slide_image.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                  class="ai-carousel-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-carousel-image-placeholder-{{ ai_gen_id }}">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_overlay %}
                <div class="ai-carousel-overlay-{{ ai_gen_id }}"></div>
              {% endif %}

              <div class="ai-carousel-content-{{ ai_gen_id }}">
                <div class="ai-carousel-content-inner-{{ ai_gen_id }}">
                  {% if slide_heading != blank %}
                    <h2 class="ai-carousel-heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
                  {% endif %}

                  {% if slide_subheading != blank %}
                    <div class="ai-carousel-subheading-{{ ai_gen_id }}">{{ slide_subheading }}</div>
                  {% endif %}

                  {% if slide_text != blank %}
                    <div class="ai-carousel-text-{{ ai_gen_id }}">{{ slide_text }}</div>
                  {% endif %}

                  {% if slide_button_text != blank and slide_button_link != blank %}
                    <a href="{{ slide_button_link }}" class="ai-carousel-button-{{ ai_gen_id }}">
                      {{ slide_button_text }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
        data-direction="prev"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}"
        aria-label="Next slide"
        data-direction="next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-carousel-dots-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}'));
        this.totalSlides = this.slides.length;
        
        if (this.totalSlides === 0) return;

        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;

        this.setupNavigation();
        this.setupDots();
        
        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      setupNavigation() {
        const prevBtn = this.querySelector('.ai-carousel-nav-prev-{{ ai_gen_id }}');
        const nextBtn = this.querySelector('.ai-carousel-nav-next-{{ ai_gen_id }}');

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            this.goToSlide(this.currentSlide - 1);
            if (this.autoplay) {
              this.resetAutoplay();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            this.goToSlide(this.currentSlide + 1);
            if (this.autoplay) {
              this.resetAutoplay();
            }
          });
        }
      }

      setupDots() {
        const dotsContainer = this.querySelector('.ai-carousel-dots-{{ ai_gen_id }}');
        if (!dotsContainer) return;

        dotsContainer.innerHTML = '';
        
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.className = 'ai-carousel-dot-{{ ai_gen_id }}' + (index === 0 ? ' active' : '');
          dot.setAttribute('aria-label', 'Go to slide ' + (index + 1));
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            if (this.autoplay) {
              this.resetAutoplay();
            }
          });
          dotsContainer.appendChild(dot);
        });

        this.dots = Array.from(dotsContainer.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}'));
      }

      goToSlide(index) {
        if (index < 0) {
          index = this.totalSlides - 1;
        } else if (index >= this.totalSlides) {
          index = 0;
        }

        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.goToSlide(this.currentSlide + 1);
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

