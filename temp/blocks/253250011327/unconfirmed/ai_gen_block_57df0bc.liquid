{% doc %}
  @prompt
    create a carousel to accept multiple images and also we can overlay multiple  text and button we can also custimised size and color , and image of size , and alginment of text and button , carosel button showing or not , timing or many more feature  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.carousel_height }}px;
  }

  .ai-carousel-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}ms ease-in-out;
    pointer-events: none;
  }

  .ai-carousel-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-carousel-content-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.content_vertical_alignment == 'top' %}
      top: {{ block.settings.content_padding }}px;
    {% elsif block.settings.content_vertical_alignment == 'center' %}
      top: 50%;
      transform: translateY(-50%);
    {% else %}
      bottom: {{ block.settings.content_padding }}px;
    {% endif %}
    {% if block.settings.content_horizontal_alignment == 'left' %}
      left: {{ block.settings.content_padding }}px;
      text-align: left;
    {% elsif block.settings.content_horizontal_alignment == 'center' %}
      left: 50%;
      transform: translateX(-50%) {% if block.settings.content_vertical_alignment == 'center' %}translateY(-50%){% endif %};
      text-align: center;
    {% else %}
      right: {{ block.settings.content_padding }}px;
      text-align: right;
    {% endif %}
    max-width: {{ block.settings.content_max_width }}%;
    z-index: 2;
  }

  .ai-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
    font-weight: 700;
  }

  .ai-carousel-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
  }

  .ai-carousel-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.button_spacing }}px;
  }

  .ai-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  {% if block.settings.show_navigation %}
    .ai-carousel-nav-{{ ai_gen_id }} {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      background-color: {{ block.settings.nav_bg_color }};
      color: {{ block.settings.nav_icon_color }};
      border: none;
      width: {{ block.settings.nav_button_size }}px;
      height: {{ block.settings.nav_button_size }}px;
      border-radius: {{ block.settings.nav_border_radius }}px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      opacity: {{ block.settings.nav_opacity }};
    }

    .ai-carousel-nav-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.nav_hover_bg_color }};
      color: {{ block.settings.nav_hover_icon_color }};
      opacity: 1;
    }

    .ai-carousel-nav-prev-{{ ai_gen_id }} {
      left: {{ block.settings.nav_offset }}px;
    }

    .ai-carousel-nav-next-{{ ai_gen_id }} {
      right: {{ block.settings.nav_offset }}px;
    }

    .ai-carousel-nav-{{ ai_gen_id }} svg {
      width: calc({{ block.settings.nav_button_size }}px * 0.5);
      height: calc({{ block.settings.nav_button_size }}px * 0.5);
    }
  {% endif %}

  {% if block.settings.show_dots %}
    .ai-carousel-dots-{{ ai_gen_id }} {
      position: absolute;
      bottom: {{ block.settings.dots_offset }}px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: {{ block.settings.dots_spacing }}px;
      z-index: 3;
    }

    .ai-carousel-dot-{{ ai_gen_id }} {
      width: {{ block.settings.dot_size }}px;
      height: {{ block.settings.dot_size }}px;
      border-radius: 50%;
      background-color: {{ block.settings.dot_color }};
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      opacity: {{ block.settings.dot_opacity }};
    }

    .ai-carousel-dot-{{ ai_gen_id }}.active {
      background-color: {{ block.settings.dot_active_color }};
      opacity: 1;
      transform: scale({{ block.settings.dot_active_scale }});
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-carousel-container-{{ ai_gen_id }} {
      height: {{ block.settings.carousel_height_mobile }}px;
    }

    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-carousel-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.8);
    }

    .ai-carousel-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }

    .ai-carousel-content-{{ ai_gen_id }} {
      max-width: 90%;
    }
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }}
  class="ai-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-carousel-container-{{ ai_gen_id }}">
    <div class="ai-carousel-slides-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_image_key = 'slide_' | append: i | append: '_image'
          assign slide_heading_key = 'slide_' | append: i | append: '_heading'
          assign slide_subheading_key = 'slide_' | append: i | append: '_subheading'
          assign slide_text_key = 'slide_' | append: i | append: '_text'
          assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
          assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign slide_image = block.settings[slide_image_key]
          assign slide_heading = block.settings[slide_heading_key]
          assign slide_subheading = block.settings[slide_subheading_key]
          assign slide_text = block.settings[slide_text_key]
          assign slide_button_text = block.settings[slide_button_text_key]
          assign slide_button_link = block.settings[slide_button_link_key]
        %}

        {% if slide_enabled %}
          <div class="ai-carousel-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
            <div class="ai-carousel-image-wrapper-{{ ai_gen_id }}">
              {% if slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 2000 }}"
                  alt="{{ slide_image.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                  class="ai-carousel-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              
              {% if block.settings.show_overlay %}
                <div class="ai-carousel-overlay-{{ ai_gen_id }}"></div>
              {% endif %}

              {% if slide_heading != blank or slide_subheading != blank or slide_text != blank or slide_button_text != blank %}
                <div class="ai-carousel-content-{{ ai_gen_id }}">
                  {% if slide_heading != blank %}
                    <h2 class="ai-carousel-heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
                  {% endif %}
                  
                  {% if slide_subheading != blank %}
                    <p class="ai-carousel-subheading-{{ ai_gen_id }}">{{ slide_subheading }}</p>
                  {% endif %}
                  
                  {% if slide_text != blank %}
                    <div class="ai-carousel-text-{{ ai_gen_id }}">{{ slide_text }}</div>
                  {% endif %}
                  
                  {% if slide_button_text != blank %}
                    <a
                      href="{{ slide_button_link | default: '#' }}"
                      class="ai-carousel-button-{{ ai_gen_id }}"
                    >
                      {{ slide_button_text }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-carousel-dots-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}'));
        this.totalSlides = this.slides.length;
        
        if (this.totalSlides === 0) return;

        this.setupNavigation();
        this.setupDots();
        this.setupAutoplay();
      }

      setupNavigation() {
        const prevBtn = this.querySelector('.ai-carousel-nav-prev-{{ ai_gen_id }}');
        const nextBtn = this.querySelector('.ai-carousel-nav-next-{{ ai_gen_id }}');

        if (prevBtn) {
          prevBtn.addEventListener('click', () => this.previousSlide());
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => this.nextSlide());
        }
      }

      setupDots() {
        const dotsContainer = this.querySelector('.ai-carousel-dots-{{ ai_gen_id }}');
        if (!dotsContainer) return;

        dotsContainer.innerHTML = '';
        
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-carousel-dot-{{ ai_gen_id }}' + (i === 0 ? ' active' : '');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.addEventListener('click', () => this.goToSlide(i));
          dotsContainer.appendChild(dot);
        }

        this.dots = Array.from(dotsContainer.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}'));
      }

      setupAutoplay() {
        const autoplay = this.dataset.autoplay === 'true';
        const autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;

        if (autoplay && this.totalSlides > 1) {
          this.startAutoplay(autoplaySpeed);

          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay(autoplaySpeed));
        }
      }

      startAutoplay(speed) {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => this.nextSlide(), speed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.totalSlides;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.goToSlide(prevIndex);
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

